# .env 로 복사해서 쓴다(.env는 git에 올라가지 않는다)
# GPT-SoVITS 통합 패키지 폴더(runtime\python.exe 와 GPT_SoVITS\ 가 있는 곳)
VOICELAB_GSV_ROOT=C:\GPT-SoVITS
# 녹음·학습 데이터 위치(기본: 레포의 data\)
# VOICELAB_DATA=D:\voicelab-data
# VOICELAB_PORT=8830
# 세션 서명 키: 비워 두면 서버가 처음 켤 때 만들어 이 파일에 덧붙인다
# VOICELAB_SECRET=
# 대본 일치 검사용 받아쓰기(OpenAI 호환 /v1/audio/transcriptions). 비우면 그 검사만 건너뛴다
# VOICELAB_ASR_URL=http://127.0.0.1:8800/v1/audio/transcriptions
# VOICELAB_ASR_KEY=
# 같은 GPU를 쓰는 다른 서버: 학습 동안 내릴 프로세스(명령줄에 든 글자, 쉼표로 여러 개)와 다시 켤 명령
# VOICELAB_PAUSE_MATCH=my_server.py,start_my_server.bat
# VOICELAB_RESUME_CMD=cmd.exe /c C:\path\start_my_server.bat
# 시험용 짧은 학습(SoVITS,GPT 에폭). 실서비스에서는 빼기
# VOICELAB_EPOCHS=2,3
